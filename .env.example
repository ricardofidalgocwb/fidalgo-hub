# Fidalgo Hub / Heros Custom — variáveis de ambiente
# Copie para .env e preencha. NUNCA commite o arquivo .env.

# ====================== NOTION (SSOT) ======================
# Integration token: https://www.notion.so/my-integrations
# Compartilhe Fila Founder (e só o que for usar) com a integration.
NOTION_TOKEN=
NOTION_VERSION=2022-06-28

# Database legado do workflow semanal de governança (não é a Fila Founder)
NOTION_DATABASE_ID=

# ====================== PAINEL FOUNDER ======================
# Dry-run é o padrão. Só escreve no Notion se CONFIRM=1 (CLI)
# ou se a UI enviar confirmed=true COM token presente.
CONFIRM=0
FOUNDER_PANEL_HOST=127.0.0.1
FOUNDER_PANEL_PORT=5050

# n8n NUNCA dispara em Aprovar.
# Avançar só posta webhook se as duas linhas abaixo estiverem ativas.
N8N_AVANCAR_ENABLED=0
N8N_AVANCAR_WEBHOOK=
N8N_WEBHOOK_KEY=

# ====================== GMAIL (workflow semanal) ======================
GMAIL_USER=
GMAIL_APP_PASSWORD=
RECIPIENT_EMAIL=
CC_EMAIL=
