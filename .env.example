# Fidalgo Hub / Heros Custom — variáveis de ambiente
# Copie para .env e preencha. NUNCA commite o arquivo .env.

# ====================== NOTION (SSOT) ======================
# Integration token: https://www.notion.so/my-integrations
# Compartilhe Fila Founder e, se for usar o runner editorial, a Fila Editorial.
NOTION_TOKEN=
NOTION_VERSION=2022-06-28

# Database legado do workflow semanal de governança (não é a Fila Founder)
NOTION_DATABASE_ID=

# ====================== PAINEL FOUNDER ======================
# Dry-run é o padrão. Só escreve no Notion se CONFIRM=1 (CLI)
# ou se a UI enviar confirmed=true COM token presente.
CONFIRM=0
FOUNDER_PANEL_HOST=127.0.0.1
FOUNDER_PANEL_PORT=5050

# n8n NUNCA dispara em Aprovar.
# Avançar só posta webhook se as duas linhas abaixo estiverem ativas.
N8N_AVANCAR_ENABLED=0
N8N_AVANCAR_WEBHOOK=
N8N_WEBHOOK_KEY=

# ====================== RUNNER EDITORIAL ======================
# Fila Editorial (Editora × Produtora). Aprovar ≠ publicar.
# Dry-run é o padrão. O mesmo CONFIRM=1 acima só grava Status=Aprovado
# na fila_editorial (nunca Publicado, nunca Canal, nunca n8n/IG/PDF/site).

# ====================== GOOGLE DRIVE (Path B, opcional) ======================
# SSOT: docs/drive-binary-upload.md + scripts/README.md
# NUNCA commite o JSON. Path A (drop manual no browser) não precisa disto.
# GOOGLE_APPLICATION_CREDENTIALS=/home/voce/.config/fidalgo-hub/drive-sa.json
# GOOGLE_DRIVE_OAUTH_CLIENT_SECRETS=/home/voce/.config/fidalgo-hub/client_secret.json
# GOOGLE_DRIVE_OAUTH_TOKEN=/home/voce/.config/fidalgo-hub/drive_token.json

# ====================== GMAIL (workflow semanal) ======================
GMAIL_USER=
GMAIL_APP_PASSWORD=
RECIPIENT_EMAIL=
CC_EMAIL=
