# Fidalgo Hub - Gitignore

# Variáveis de ambiente locais
.env
.env.local
.env.*.local

# Arquivos de sistema
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# IDEs
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Testes
.pytest_cache/
.coverage
htmlcov/

# Relatórios locais
validation_report_*.json
validation_report_*.md
validation_output.log

# Logs
*.log
logs/

# Temporários
tmp/
temp/
*.tmp

# Google Drive / GCP — nunca commitar credencial ou token
client_secret*.json
*-credentials.json
*service-account*.json
token.json
token.pickle
.google/
